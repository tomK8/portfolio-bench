<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.3</version>
        <relativePath/>
    </parent>

    <groupId>com.portfolio</groupId>
    <artifactId>portfolio-bench</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <properties>
        <java.version>25</java.version>
        <poi.version>5.3.0</poi.version>
        <!-- Default: skip @Tag("integration") tests (e.g. live Yahoo API).
             Run them with: mvn test -Dgroups=integration -DexcludedGroups= -->
        <excludedGroups>integration</excludedGroups>
    </properties>

    <dependencies>
        <!-- Web + server-rendered UI -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>

        <!-- SMTP alert emails (Jakarta Mail API + Angus impl; used framework-free in the adapter) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <!-- Excel generation -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>${poi.version}</version>
        </dependency>

        <!-- CSV parsing -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-csv</artifactId>
            <version>1.11.0</version>
        </dependency>

        <!-- SQLite -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.46.0.0</version>
        </dependency>

        <!-- Dev-time auto-restart: watches target/classes and restarts the app in-JVM
             when .class files change. Marked optional so it isn't pulled into the
             packaged fat jar (scripts/start.sh) — only active under `mvn spring-boot:run`. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Testing (JUnit 5 + Spring test support; versions managed by the Boot parent) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Architecture rules in test scope: no runtime dependency, no annotations in main.
             Plain archunit, not archunit-junit5: the rules are driven from ordinary @Test methods.
             Its JUnit 5 engine is not picked up by this surefire setup — it loads, reads its
             config, and contributes zero tests, so a broken rule passed the build. See
             LayerRulesTest. -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit</artifactId>
            <version>1.4.1</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.portfolio.PortfolioBenchApplication</mainClass>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <excludedGroups>${excludedGroups}</excludedGroups>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.13</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals><goal>prepare-agent</goal></goals>
                    </execution>
                    <!-- Bound to test, not verify: the discipline here is `mvn test` before a
                         commit, and `mvn package` does not reach the verify phase. Declared after
                         surefire so it runs after it within the same phase. -->
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals><goal>report</goal></goals>
                    </execution>
                    <!-- A ratchet, not a target. Every figure below is where the suite actually
                         stood when it was measured, rounded down: the build fails on a regression,
                         and a number is raised only after coverage has already improved past it.
                         Never lower one to make a commit pass.

                         web and config are excluded. The controllers are thin by design and the
                         coverage there (25.9% line) measures Thymeleaf wiring, not logic; holding
                         them to a floor would buy tests that assert a model attribute exists. -->
                    <execution>
                        <id>check</id>
                        <phase>test</phase>
                        <goals><goal>check</goal></goals>
                        <configuration>
                            <excludes>
                                <exclude>com/portfolio/web/**</exclude>
                                <exclude>com/portfolio/config/**</exclude>
                            </excludes>
                            <rules>
                                <!-- Measured 80.7% line / 65.5% branch, 2026-11-04. -->
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.80</minimum></limit>
                                        <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.65</minimum></limit>
                                    </limits>
                                </rule>
                                <!-- domain is pure logic with no I/O, so it is held highest.
                                     Lowest member at measurement: domain.model 94.6% line,
                                     domain.swing 75.9% branch. -->
                                <rule>
                                    <element>PACKAGE</element>
                                    <includes><include>com.portfolio.domain*</include></includes>
                                    <excludes><exclude>com.portfolio.domain.range</exclude></excludes>
                                    <limits>
                                        <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.94</minimum></limit>
                                        <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.75</minimum></limit>
                                    </limits>
                                </rule>
                                <!-- domain.range is the outlier: 65.8% line against 97%+ for the
                                     other three backtest engines. Its own rung on the ratchet so
                                     the gap is visible rather than averaged away, and so raising it
                                     is a one-line diff when the tests land. -->
                                <rule>
                                    <element>PACKAGE</element>
                                    <includes><include>com.portfolio.domain.range</include></includes>
                                    <limits>
                                        <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.65</minimum></limit>
                                        <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.50</minimum></limit>
                                    </limits>
                                </rule>
                                <rule>
                                    <element>PACKAGE</element>
                                    <includes><include>com.portfolio.persistence</include></includes>
                                    <limits>
                                        <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.82</minimum></limit>
                                        <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.70</minimum></limit>
                                    </limits>
                                </rule>
                                <rule>
                                    <element>PACKAGE</element>
                                    <includes><include>com.portfolio.parser</include></includes>
                                    <limits>
                                        <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.89</minimum></limit>
                                        <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.66</minimum></limit>
                                    </limits>
                                </rule>
                                <rule>
                                    <element>PACKAGE</element>
                                    <includes><include>com.portfolio.application</include></includes>
                                    <limits>
                                        <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.71</minimum></limit>
                                        <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.56</minimum></limit>
                                    </limits>
                                </rule>
                                <rule>
                                    <element>PACKAGE</element>
                                    <includes><include>com.portfolio.adapter</include></includes>
                                    <limits>
                                        <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.69</minimum></limit>
                                        <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.60</minimum></limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
